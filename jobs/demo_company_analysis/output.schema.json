{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "company_name",
    "summary",
    "employee_count",
    "salary",
    "references"
  ],
  "properties": {
    "company_name": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "employee_count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "scope", "as_of", "source_note"],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 0
        },
        "scope": {
          "type": "string",
          "enum": ["consolidated", "non_consolidated", "unknown"]
        },
        "as_of": {
          "type": "string"
        },
        "source_note": {
          "type": "string"
        }
      }
    },
    "salary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value_jpy", "label", "as_of", "source_note"],
      "properties": {
        "value_jpy": {
          "type": "integer",
          "minimum": 0
        },
        "label": {
          "type": "string",
          "enum": ["average_annual_salary", "starting_salary", "estimated", "unknown"]
        },
        "as_of": {
          "type": "string"
        },
        "source_note": {
          "type": "string"
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "note"],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
